# ==========================================================
#  PORTLAR — yerel geliştirme
#  Varsayılanlar bilerek yüksek ve nadir seçildi. Doluysa değiştir.
# ==========================================================
HABIE_DB_PORT=55432        # Postgres (docker)  — 5432 DEĞİL
HABIE_GATEWAY_PORT=8791    # Habie gateway + WebSocket
HABIE_WEB_PORT=5199        # Vite demo arayüzü  — 5173 DEĞİL
HABIE_TOKEN_PORT=5198      # Yerel token sunucusu (host backend taklidi)

# ==========================================================
#  SECRET'LAR
#  Üretmek için:
#  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ==========================================================
SESSION_SECRET=BURAYA_BIRINCI_DEGER

# Tek satır JSON. Render ve Netlify'da BİREBİR aynı olmalı.
APP_SECRETS={"projelio":"BURAYA_IKINCI_DEGER","stokla":"BURAYA_UCUNCU_DEGER"}

# ==========================================================
#  VERİTABANI
#  Yerelde boş bırak — docker compose'daki değer kullanılır.
#  Neon'a bağlanırken buraya pooled connection string'i yapıştır.
# ==========================================================
# DATABASE_URL=postgresql://...@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ==========================================================
#  BİLDİRİMLER (Web Push)
#  Üretmek için:  npm run vapid
#  Anahtarları değiştirirsen mevcut tüm abonelikler geçersiz olur.
# ==========================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@rundeer.app

# ==========================================================
#  HOST UYGULAMA (Lio)
#  Habie'nin ajan sohbeti doğrudan bu API'ye konuşur.
# ==========================================================
VITE_PROJELIO_API=https://projelio-backend.onrender.com
# Projelio'nun web uygulaması — /habie devir sayfasının bulunduğu adres
VITE_PROJELIO_WEB=https://projelio.netlify.app

# ==========================================================
#  ÜRETİM (yerelde gerekmez)
# ==========================================================
# NODE_ENV=production
# ALLOWED_ORIGINS=https://siteniz.netlify.app
# VITE_GATEWAY=https://habie-gateway.onrender.com
